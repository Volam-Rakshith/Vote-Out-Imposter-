# Copy to .env for local development ONLY. Never commit a real .env.
#
# These are SERVER-side secrets for the Supabase edge function (Supabase sets
# them automatically in the cloud). Never place the service-role key in
# browser code.

# Supabase project API URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# Service role key — full database access. Server side only!
SUPABASE_SERVICE_ROLE_KEY=
